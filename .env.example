# Nexus Docker Environment Variables

# LLM API Keys (at least one required for rotating provider)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Logging level (optional)
# Options: debug, info, warn, error
LOG_LEVEL=info

# Radio settings (optional, defaults work for most cases)
# RADIO_ENABLED=true
# RADIO_STREAM_PORT=8080

# YouTube settings (optional)
# YOUTUBE_ENABLED=true

# QuickCom settings (optional)
# NODE_ENV=production
# DEBUG=puppeteer:*
