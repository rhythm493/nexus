# Nexus Environment Variables
# Server auto-loads this file on startup. Env vars override .env values.

# --- API Keys (required for rotating LLM provider) ---
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- CLIProxyAPI (optional, for Gemini via proxy on localhost:24080) ---
# CLIPROXY_API_KEY=nexus-local
# CLIPROXY_URL=http://localhost:24080

# --- QuickCom (grocery mode, defaults to localhost:5000) ---
# QUICKCOM_URL=http://localhost:5000

# --- Server ---
# LOG_LEVEL=info
# SERVER_PORT=8443
# SERVICE_NAME=nexus

# --- TLS ---
# CERTS_DIR=./certs

# --- MCP ---
# MCP_SERVERS_DIR=./mcp-repos

# --- LLM overrides (bypass rotating provider) ---
# LLM_PROVIDER=groq
# LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# --- Radio ---
# RADIO_ENABLED=true
# LIQUIDSOAP_PATH=liquidsoap
# RADIO_SCRIPT_PATH=./scripts/radio.liq
# RADIO_TELNET_HOST=127.0.0.1
# RADIO_TELNET_PORT=1234
# RADIO_STREAM_PORT=8080
# RADIO_STREAM_HOST=localhost
# RADIO_CROSSFADE_SECS=3
# RADIO_AUTO_START=false

# --- YouTube ---
# YOUTUBE_ENABLED=true
# YOUTUBE_BIN_DIR=./data/bin
# YOUTUBE_OUTPUT_DIR=./data/library

# --- Library ---
# LIBRARY_DATA_DIR=./data/library
# LIBRARY_DATABASE_PATH=./data/library.db
# LIBRARY_MAX_SIZE_MB=5000
